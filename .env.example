# Copy this file to .env and change values if needed.
# Never put your X password here. Login is done by hand with: python -m scanner.login

# Which data source to use (folder name under scanner/sources/)
DATA_SOURCE=x_playwright

# How often to check X for new posts, in minutes
POLL_MINUTES=3

# On startup, read back at most this many days of posts
CATCHUP_DAYS=7

# Delete posts older than this many days
PRUNE_DAYS=8

# Show the scraping browser window (false) or hide it (true)
HEADLESS=true

# File locations (relative to the project folder)
DB_PATH=data/scanner.db
AUTH_STATE_PATH=.auth/state.json
SYMBOLS_CACHE_DIR=data/symbols

# Web server
HOST=127.0.0.1
PORT=8000

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
